{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 2 Risk Analysis Output",
  "description": "Schema for the risk analysis stage output. Enforces RISK-NNN IDs, verdict gates, numeric scoring, and RT-NNN test IDs. CONDITIONAL verdict requires a non-empty condition field.",
  "type": "object",
  "required": ["risks", "tests", "summary", "stage_summary"],
  "additionalProperties": false,
  "properties": {
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "maps_to_reqs",
          "verdict_gate",
          "attack_vector",
          "exploitability",
          "impact",
          "detectability",
          "novelty",
          "overall_rating",
          "linked_test_id",
          "high_leverage"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RISK-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "maps_to_reqs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3}$"
            },
            "minItems": 1,
            "description": "Every risk must map to at least one upstream requirement"
          },
          "verdict_gate": {
            "type": "string",
            "enum": ["PASS", "CONDITIONAL", "FAIL"]
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "description": "Required when verdict_gate is CONDITIONAL. Describes what condition must be met."
          },
          "attack_vector": {
            "type": "string",
            "minLength": 10,
            "description": "Description of how an attacker exploits this risk"
          },
          "exploitability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "detectability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "novelty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "How novel or AI-specific the attack vector is (1=well-known, 10=novel AI-native)"
          },
          "overall_rating": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "linked_test_id": {
            "type": "string",
            "pattern": "^RT-[0-9]{3}$",
            "description": "The primary test that validates or invalidates this risk"
          },
          "high_leverage": {
            "type": "boolean",
            "description": "True if mitigating this risk defends against multiple attack scenarios"
          }
        },
        "if": {
          "properties": {
            "verdict_gate": { "const": "CONDITIONAL" }
          },
          "required": ["verdict_gate"]
        },
        "then": {
          "required": ["condition"],
          "properties": {
            "condition": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "validates_risks",
          "setup",
          "procedure",
          "expected_vuln_present",
          "expected_mitigation_present",
          "pass_criterion",
          "test_type",
          "tooling"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RT-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "validates_risks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RISK-[0-9]{3}$"
            },
            "minItems": 1
          },
          "setup": {
            "type": "string",
            "minLength": 10,
            "description": "Pre-conditions and environment setup required to run this test"
          },
          "procedure": {
            "type": "string",
            "minLength": 10,
            "description": "Step-by-step test execution procedure"
          },
          "expected_vuln_present": {
            "type": "string",
            "minLength": 5,
            "description": "What the test observes when the vulnerability is present (test should FAIL)"
          },
          "expected_mitigation_present": {
            "type": "string",
            "minLength": 5,
            "description": "What the test observes when the mitigation is in place (test should PASS)"
          },
          "pass_criterion": {
            "type": "string",
            "minLength": 10,
            "description": "Explicit, measurable criterion for the test to pass"
          },
          "test_type": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "code-audit",
              "config-check",
              "runtime-monitor",
              "chained-scenario"
            ]
          },
          "tooling": {
            "type": "string",
            "minLength": 2,
            "description": "Tools or frameworks used to execute this test (e.g., pytest, garak, curl, manual)"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["risk_count_by_rating", "conditional_count", "top_high_leverage_ids"],
      "additionalProperties": false,
      "properties": {
        "risk_count_by_rating": {
          "type": "object",
          "required": ["critical", "high", "medium", "low"],
          "additionalProperties": false,
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        },
        "conditional_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of risks with verdict_gate == CONDITIONAL"
        },
        "top_high_leverage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RISK-[0-9]{3}$"
          },
          "description": "IDs of high-leverage risks (mitigating them defends against the most attack surface)"
        }
      }
    },
    "stage_summary": {
      "type": "string",
      "maxLength": 1200,
      "description": "200-word-max summary for Stage 3 describing top risks, verdict gates, and test coverage"
    }
  }
}
