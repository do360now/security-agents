{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 3 Solutions Output",
  "description": "Schema for the solutions stage output. Enforces SOL-NNN IDs, priority tiers, roadmap sprints, and the honesty field (does_not_defend_against).",
  "type": "object",
  "required": ["solutions", "roadmap", "summary", "stage_summary"],
  "additionalProperties": false,
  "properties": {
    "solutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "targets_risks",
          "targets_reqs",
          "priority",
          "target_file",
          "change_description",
          "validates_against_test",
          "effort_hours",
          "does_not_defend_against"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SOL-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "targets_risks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RISK-[0-9]{3}$"
            },
            "minItems": 1
          },
          "targets_reqs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3}$"
            },
            "minItems": 1
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"],
            "description": "P0=fix immediately (critical/high FAIL), P1=fix this sprint (high/medium CONDITIONAL), P2=planned (medium/low)"
          },
          "target_file": {
            "type": "string",
            "minLength": 1,
            "description": "Primary file or component where the change is applied"
          },
          "change_description": {
            "type": "string",
            "minLength": 20,
            "description": "Concrete description of the code or configuration change required"
          },
          "validates_against_test": {
            "type": "string",
            "pattern": "^RT-[0-9]{3}$",
            "description": "The test ID that passes when this solution is implemented"
          },
          "effort_hours": {
            "type": "number",
            "minimum": 0.5,
            "description": "Estimated implementation effort in hours"
          },
          "does_not_defend_against": {
            "type": "string",
            "minLength": 10,
            "description": "Mandatory honesty field: what attack vectors or risks this solution does NOT address"
          }
        }
      }
    },
    "roadmap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sprint", "items", "total_hours_estimate"],
        "additionalProperties": false,
        "properties": {
          "sprint": {
            "type": "integer",
            "minimum": 1,
            "description": "Sprint number (1-based)"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SOL-[0-9]{3}$"
            },
            "minItems": 1
          },
          "total_hours_estimate": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["solution_count_by_priority", "highest_leverage_sol", "total_effort_hours"],
      "additionalProperties": false,
      "properties": {
        "solution_count_by_priority": {
          "type": "object",
          "required": ["P0", "P1", "P2"],
          "additionalProperties": false,
          "properties": {
            "P0": { "type": "integer", "minimum": 0 },
            "P1": { "type": "integer", "minimum": 0 },
            "P2": { "type": "integer", "minimum": 0 }
          }
        },
        "highest_leverage_sol": {
          "type": "string",
          "pattern": "^SOL-[0-9]{3}$",
          "description": "The single solution that defends against the most risk surface"
        },
        "total_effort_hours": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stage_summary": {
      "type": "string",
      "maxLength": 1200,
      "description": "200-word-max summary covering solution count, priority breakdown, roadmap, and residual risk"
    }
  }
}
